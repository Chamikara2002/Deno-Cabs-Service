{
  "name": "deno-cabs-backend",
  "version": "1.0.0",
  "description": "Express.js and MongoDB Backend for Deno Cabs Hire, Fleet & Dispatch Management",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node -e 'import(\"./data/seedData.js\").then(m => m.seedDatabase())'"
  },
  "keywords": [
    "deno-cabs",
    "express",
    "mongodb",
    "mongoose",
    "hire-booking",
    "fleet-dispatch"
  ],
  "author": "Deno Cabs Development Team",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongoose": "^8.3.4",
    "morgan": "^1.10.0",
    "nodemailer": "^10.0.15"
  }
}
