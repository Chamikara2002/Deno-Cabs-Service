# ==========================================================
# Deno Cabs & Tours - Root Environment Configuration Template
# (Copy this file to .env and fill in your actual credentials)
# ==========================================================

PORT=5000
NODE_ENV=development

# MongoDB Connection String (Replace with your local or MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/deno_cabs_db

# Allowed CORS Origins (Comma-separated)
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ================= EMAIL DISPATCH (SMTP CONFIGURATION) =================
# For Gmail: Enable 2-Step Verification and generate an App Password
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_letter_app_password
SMTP_FROM="Deno Cabs & Tours" <your_email@gmail.com>

# ================= SMS GATEWAY (OPTIONAL) =================
# SMS_API_URL=https://api.notify.lk/api/v1/send
# SMS_API_KEY=your_sms_api_key
# SMS_SENDER_ID=DenoCabs
