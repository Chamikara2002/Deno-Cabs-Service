# =======================================================
# Deno Cabs & Tours - Secure .gitignore Configuration
# =======================================================

# 1. Environment & Secret Variables Files (STRICTLY IGNORED)
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
backend/.env.*
!backend/.env.example

# 2. Dependencies & Package Managers
node_modules/
backend/node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# 3. Production Builds & Outputs
dist/
dist-ssr/
build/
out/
.next/
.cache/
.vite/
*.tsbuildinfo

# 4. Logs & Diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 5. OS & System Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# 6. IDE & Editor Configs
.vscode/
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# 7. Secrets, Certificates, Keys & Credentials
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
credentials.json
client_secret*.json
auth.json
serviceAccountKey.json

# 8. Temporary & Scratch Files
tmp/
temp/
scratch/
.system_generated/
